# =============================================================================
# LLM API Monetization Proxy — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Mainlayer (required)
# -----------------------------------------------------------------------------

# Your Mainlayer API key — get one at https://mainlayer.xyz
MAINLAYER_API_KEY=ml_your_api_key_here

# The resource ID you registered in the Mainlayer dashboard for this API
MAINLAYER_RESOURCE_ID=llm-api-default

# Mainlayer API base URL (do not change unless using a private instance)
MAINLAYER_BASE_URL=https://api.mainlayer.xyz

# -----------------------------------------------------------------------------
# Upstream LLM (required)
# -----------------------------------------------------------------------------

# API key for the upstream LLM provider
LLM_API_KEY=sk-your-openai-or-compatible-key-here

# Base URL of the upstream OpenAI-compatible API
# OpenAI:     https://api.openai.com
# Groq:       https://api.groq.com/openai
# Together:   https://api.together.xyz
# OpenRouter: https://openrouter.ai/api
# Ollama:     http://localhost:11434
LLM_BASE_URL=https://api.openai.com

# Default model to use when the client does not specify one
LLM_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Pricing (optional — defaults shown)
# -----------------------------------------------------------------------------

# Price in USD per 1,000 tokens
PRICE_PER_1K_TOKENS=0.01

# Minimum tokens to charge per request (covers overhead)
MIN_TOKENS_PER_REQUEST=10

# -----------------------------------------------------------------------------
# Proxy behaviour (optional)
# -----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (* = all)
CORS_ORIGINS=*

# Fail open: if true, allow requests through when Mainlayer is unreachable.
# Keep false (fail closed) in production.
FAIL_OPEN=false

# Port the proxy listens on
PORT=8000
